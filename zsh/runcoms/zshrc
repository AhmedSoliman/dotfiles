#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...
fpath=(~/.zfunc $fpath)
fpath=(/usr/local/share/zsh-completions $fpath)

# Homebrew completions
if type brew &>/dev/null
then
  export FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

autoload -Uz compinit
compinit

# Patched tinted-shell hooks (upstream tmux/fzf hooks are broken); see
# ~/.dotfiles/tinted-theming/hooks/README.md.
export BASE16_SHELL_HOOKS_PATH="$HOME/.dotfiles/tinted-theming/hooks"
source "$HOME/.config/base16-shell/base16-shell.plugin.zsh"

# No lag after we hit esc
export KEYTIMEOUT=1
bindkey '^r' history-incremental-search-backward
# ctrl-w removed word backwards
bindkey '^w' backward-kill-word

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Custom unix utilities
if type exa &> /dev/null
then
  alias hg='sl'
  alias ls='eza'
  alias ll='eza -l --icons --git'
  alias lt='eza -l --icons --git --tree'
  alias lll='eza -la --icons --git'
fi

if type nvim &>/dev/null
then
  alias vim='nvim'
  export EDITOR='nvim'
  export VISUAL='nvim'
fi

alias dark='base16_rose-pine-moon'
alias bright='base16_rose-pine-dawn'
unalias sl &> /dev/null


if type starship &>/dev/null
then
  # Prompt hostname (starship's env_var.PROMPT_HOST) in the machine's tmux accent
  # colour: ~/.tmux.host.conf (Ansible, host_vars host_color), else tmux-status.conf's
  # default. Starship styles can't read variables, so the colour is baked in here.
  host_color=31
  [[ -r ~/.tmux.host.conf && "$(<~/.tmux.host.conf)" =~ '@host_color "colour([0-9]+)"' ]] && host_color=$match[1]
  export PROMPT_HOST=$'\e[1;38;5;'${host_color}m${SSH_CONNECTION:+🌐 }${HOST%%.*}$'\e[0m'
  unset host_color
  eval "$(starship init zsh)"
fi



export WASMTIME_HOME="$HOME/.wasmtime"
export PATH="$WASMTIME_HOME/bin:$PATH"
#export PATH="/opt/homebrew/opt/node@22/bin:$PATH"
#export LDFLAGS="-L/opt/homebrew/opt/node@22/lib"
#export CPPFLAGS="-I/opt/homebrew/opt/node@22/include"


# Custom fzf config if exists
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
fi

# Custom zshrc if exists
[ -f ~/.custom.zshrc ] && source ~/.custom.zshrc

. "$HOME/.local/bin/env"

# direnv: load per-directory .envrc files (only if direnv is installed)
if (( $+commands[direnv] )); then
  eval "$(direnv hook zsh)"
fi
